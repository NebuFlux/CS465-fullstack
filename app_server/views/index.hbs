<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Travlr Getaways Website Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header}}
			<div id="contents">
				<div id="adbox">
					<img src="{{homePage.hero.image}}" alt="Img">
					<h1>{{homePage.hero.title}}</h1>
					{{{homePage.hero.text}}}
				</div>
				<div id="main">
					<div class="box">
						<div>
							<div>
								<h3>Latest Blog</h3>
								<ul>
									{{#each homePage.blogPosts}}
									<li>
										<h4><a href="{{this.url}}">{{this.title}}</a></h4>
										<span>{{this.date}}</span>
										<p>{{this.excerpt}}</p>
									</li>
									{{/each}}
								</ul>
							</div>
						</div>
					</div>
					<div id="testimonials" class="box">
					<div>
						<div>
							<h3>Testimonials</h3>
							{{#each homePage.testimony}}
							<p>"{{this.quote}}"<span>- <a href="{{this.url}}">{{this.author}}</a></span></p>
							{{/each}}
						</div>
					</div>
				</div>
				</div>
				<div id="sidebar">
					{{#each homePage.promos}}
					<div class="section">
						<a href="{{this.url}}"><img src="{{this.image}}" alt="Img"></a>
					</div>
					{{/each}}
				</div>
			</div>
		</div>
		{{> footer}}
	</div>
</body>
</html>