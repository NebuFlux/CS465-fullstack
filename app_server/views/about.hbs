<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>About - Travlr Getaways Web Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header}}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>About</h1>
							<h2>{{aboutTravlr.mainArticle.title}}</h2>
							{{> paragraphParser paragraphs=aboutTravlr.mainArticle.paragraphs}}
							<hr>
							<div class="ads">
								{{#each aboutTravlr.ads}}
								<h2>{{this.title}}</h2>
								<p>{{{this.description}}}</p>
								{{/each}}
							</div>
							{{#each aboutTravlr.subArticles}}
							<h2>{{this.title}}</h2>
							<p>{{{this.details}}}</p>
							{{/each}}
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer}}
	</div>
</body>
</html>